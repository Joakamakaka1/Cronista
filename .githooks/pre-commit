#!/bin/sh
# Blocks commits that contain secrets or players' personal data. Never bypass with --no-verify.
# Enabled with `git config core.hooksPath .githooks` (pnpm install does it via the `prepare` script).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (Windows: scoop install gitleaks). Commit blocked." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
