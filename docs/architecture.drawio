5" width="650" height="118" as="geometry"/></mxCell><mxCell id="terraform" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;GitHub plans on PRs, Cloudflare on the owner laptop&lt;br&gt;applies from the owner laptop&lt;br&gt;state in the data bucket" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="1535" width="220" height="130" as="geometry"/></mxCell><mxCell id="renovate" value="&lt;b&gt;Renovate&lt;/b&gt; · weekly PR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="1630" width="238" height="44" as="geometry"/></mxCell><mxCell id="bitwarden" value="&lt;b&gt;Bitwarden&lt;/b&gt;&lt;br&gt;Secrets Manager&lt;br&gt;local keys, not in&lt;br&gt;production" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1.5;fontColor=#232F3E;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2231" y="1382" width="130" height="92" as="geometry"/></mxCell><mxCell id="e66" value="bws run" style="rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#545B64;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=55;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="bitwarden"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="NS records" style="rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;strokeColor=#545B64;dashed=1;dashPattern=6 4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.659;exitY=0;exitDx=0;exitDy=0;entryX=0.74;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="terraform" target="cloudflare"><mxGeometry relative="1" as="geometry"/></m