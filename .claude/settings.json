{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_PROFILE": "la-cronica",
    "AWS_REGION": "eu-west-1"
  },
  "permissions": {
    "ask": [
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git -C * push*)",
      "PowerShell(git -C * push*)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git -C * clean*)",
      "PowerShell(git -C * clean*)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(*cdk deploy*)",
      "PowerShell(*cdk deploy*)",
      "Bash(*cdk destroy*)",
      "PowerShell(*cdk destroy*)",
      "Bash(*supabase db push*)",
      "PowerShell(*supabase db push*)",
      "Bash(*aws ssm put-parameter*)",
      "PowerShell(*aws ssm put-parameter*)",
      "Bash(*aws ssm get-parameter*)",
      "PowerShell(*aws ssm get-parameter*)",
      "Bash(gh api *-X *)",
      "PowerShell(gh api *-X *)",
      "Bash(gh api *--method *)",
      "PowerShell(gh api *--method *)",
      "Bash(gh api *-f *)",
      "PowerShell(gh api *-f *)",
      "Bash(gh api *-F *)",
      "PowerShell(gh api *-F *)",
      "Bash(gh api *--field *)",
      "PowerShell(gh api *--field *)",
      "Bash(gh api *--raw-field *)",
      "PowerShell(gh api *--raw-field *)",
      "Bash(gh api *--input *)",
      "PowerShell(gh api *--input *)",
      "Bash(gh repo edit*)",
      "PowerShell(gh repo edit*)",
      "Bash(gh repo delete*)",
      "PowerShell(gh repo delete*)",
      "Bash(gh release *)",
      "PowerShell(gh release *)",
      "Bash(gh workflow run*)",
      "PowerShell(gh workflow run*)",
      "Bash(gh secret set*)",
      "PowerShell(gh secret set*)",
      "Bash(gh secret delete*)",
      "PowerShell(gh secret delete*)",
      "Bash(gh secret remove*)",
      "PowerShell(gh secret remove*)",
      "Bash(gh variable set*)",
      "PowerShell(gh variable set*)",
      "Bash(gh variable delete*)",
      "PowerShell(gh variable delete*)",
      "Bash(*supabase db reset*--linked*)",
      "PowerShell(*supabase db reset*--linked*)",
      "Bash(*supabase link*)",
      "PowerShell(*supabase link*)",
      "Bash(*supabase secrets set*)",
      "PowerShell(*supabase secrets set*)",
      "Bash(*supabase functions deploy*)",
      "PowerShell(*supabase functions deploy*)",
      "Edit(**/.gitleaks.toml)",
      "Edit(**/.gitleaksignore)",
      "Edit(**/.githooks/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/.github/actions/**)",
      "Edit(**/.snyk)",
      "Bash(*grep *.env*)",
      "Bash(rg *.env*)",
      "PowerShell(*Select-String*.env*)",
      "PowerShell(*sls *.env*)",
      "PowerShell(*findstr *.env*)"
    ],
    "deny": [
      "Read(~/.secrets/**)",
      "Edit(~/.secrets/**)",
      "Read(**/.secrets/**)",
      "Edit(**/.secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/credentials)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.age)",
      "Read(**/*.dump)",
      "Read(**/*.backup)",
      "Read(**/*.sql.gz)",
      "Bash(*.secrets*)",
      "PowerShell(*.secrets*)",
      "Bash(*CRONISTA_ENV_FILE*)",
      "PowerShell(*CRONISTA_ENV_FILE*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(*Get-ChildItem env:*)",
      "PowerShell(*gci env:*)",
      "PowerShell(*dir env:*)",
      "PowerShell(*ls env:*)",
      "Bash(*gh auth token*)",
      "PowerShell(*gh auth token*)",
      "Bash(*aws configure get*)",
      "PowerShell(*aws configure get*)",
      "Bash(*aws configure export-credentials*)",
      "PowerShell(*aws configure export-credentials*)",
      "Bash(*--with-decryption*)",
      "PowerShell(*--with-decryption*)",
      "Bash(git *--no-verify*)",
      "PowerShell(git *--no-verify*)",
      "Bash(git *commit -n*)",
      "PowerShell(git *commit -n*)",
      "Bash(*core.hooksPath*)",
      "PowerShell(*core.hooksPath*)",
      "Bash(git *reset *--hard*)",
      "PowerShell(git *reset *--hard*)",
      "Bash(git *push *--force*)",
      "PowerShell(git *push *--force*)",
      "Bash(git *push -f*)",
      "PowerShell(git *push -f*)",
      "Bash(git *push * -f*)",
      "PowerShell(git *push * -f*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "PowerShell(gh * pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "PowerShell(gh api *pulls/*/merge*)",
      "Bash(gh api *ergePullRequest*)",
      "PowerShell(gh api *ergePullRequest*)",
      "Bash(gh api *PullRequestAutoMerge*)",
      "PowerShell(gh api *PullRequestAutoMerge*)",
      "mcp__ccd_pr__set_auto_merge",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_supabase_supabase__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/session-start.ts"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/pre-tool-use.ts"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/post-tool-use.ts"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/stop.ts"],
            "timeout": 600,
            "statusMessage": "Running pnpm check on the uncommitted changes"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "joakamakaka-skills@skills-dir": true
  }
}
