{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(*cdk deploy*)",
      "PowerShell(*cdk deploy*)",
      "Bash(*cdk destroy*)",
      "PowerShell(*cdk destroy*)",
      "Bash(*supabase db push*)",
      "PowerShell(*supabase db push*)",
      "Bash(*aws ssm put-parameter*)",
      "PowerShell(*aws ssm put-parameter*)",
      "Bash(*aws ssm get-parameter*)",
      "PowerShell(*aws ssm get-parameter*)"
    ],
    "deny": [
      "Read(~/.secrets/**)",
      "Edit(~/.secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/credentials)",
      "PowerShell(Get-Content *.secrets*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(*--with-decryption*)",
      "PowerShell(*--with-decryption*)",
      "Bash(git commit *--no-verify*)",
      "PowerShell(git commit *--no-verify*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/session-start.ts"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/pre-tool-use.ts"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/post-tool-use.ts"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/src/stop.ts"],
            "timeout": 600,
            "statusMessage": "Running pnpm check on the uncommitted changes"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
